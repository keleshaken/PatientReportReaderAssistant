LLM_BACKEND=ollama
# google: online full-report translation, local: original local summary/Q&A mode
TRANSLATION_BACKEND=google
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional paid provider: set LLM_BACKEND=anthropic and add its key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=intfloat/multilingual-e5-base
WHISPER_MODEL=small
RETRIEVAL_K=4
MAX_UPLOAD_MB=15
SESSION_TTL_HOURS=24
